# Add these to Telegraf's environment file (e.g. /etc/default/telegraf).
# Keep the real values out of git. INFLUX_TOKEN only needs write access to the bucket.
IO_USERNAME=your_adafruit_io_username
IO_KEY=your_adafruit_io_key
IO_EVENT_FEED=appliance-events
INFLUX_TOKEN=write-only-token
INFLUX_ORG=your-org
INFLUX_BUCKET=your-bucket
