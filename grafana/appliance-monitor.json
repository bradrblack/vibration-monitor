{
  "__inputs": [
    {
      "name": "DS_INFLUX",
      "label": "InfluxDB (Flux)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "title": "Appliance Monitor",
  "uid": "appliance-monitor",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "appliances"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "CHANGE_ME",
        "current": {
          "text": "CHANGE_ME",
          "value": "CHANGE_ME"
        },
        "options": [
          {
            "selected": true,
            "text": "CHANGE_ME",
            "value": "CHANGE_ME"
          }
        ]
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUX}"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"device\")",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "On / off timeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "prior = from(bucket: \"${bucket}\")\n  |> range(start: -90d, stop: v.timeRangeStart)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\n  |> group(columns: [\"device\"])\n  |> last()\n  |> map(fn: (r) => ({r with _time: v.timeRangeStart}))\ndata = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\nunion(tables: [prior, data])\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ON",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "OFF",
                  "color": "#6e6e6e",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e6e6e",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current state",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"running\" and contains(value: r.device, set: ${device:json}))\n  |> group(columns: [\"device\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> rename(columns: {_value: \"state\"})\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "device"
            ],
            "keepFields": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ON",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "OFF",
                  "color": "#6e6e6e",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e6e6e",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state/",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Run time per day (hours)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"seconds\" and contains(value: r.device, set: ${device:json}))\n  |> map(fn: (r) => ({r with _value: r._value / 3600.0}))\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true, timeSrc: \"_start\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"device\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true
        },
        "stacking": "none"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent runs (at stop)",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUX}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r._field == \"seconds\" and contains(value: r.device, set: ${device:json}))\n  |> map(fn: (r) => ({r with minutes: r._value / 60.0}))\n  |> keep(columns: [\"_time\", \"device\", \"minutes\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stopped at"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}